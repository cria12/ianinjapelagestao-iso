#!/bin/sh
# prime-saida — display-setup-script do LightDM num portátil híbrido com o driver NVIDIA oficial
# (instalar-driver-nvidia): os ecrãs ligados à placa Intel/AMD (modesetting) passam a mostrar a
# imagem desenhada pelo NVIDIA. Sem placa modesetting não faz nada.
xrandr --listproviders 2> /dev/null | grep -q modesetting || exit 0
xrandr --setprovideroutputsource modesetting NVIDIA-0 2> /dev/null
xrandr --auto 2> /dev/null
exit 0
