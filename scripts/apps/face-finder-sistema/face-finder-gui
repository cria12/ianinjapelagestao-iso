#!/bin/sh
# face-finder-gui — interface gráfica do Face Finder (GTK 3 via PyGObject).
# Sem PyGObject/GTK disponível, abre um terminal com a ajuda da linha de comandos.
if /usr/bin/python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' 2>/dev/null; then
  exec /usr/bin/python3 /usr/share/face-finder/face_finder_gui.py "$@"
fi
msg='A interface gráfica precisa do PyGObject (GTK 3). Use a linha de comandos:'
exec xfce4-terminal --title="Face Finder" --hold -x sh -c "echo '$msg'; echo; face-finder --help; echo; echo 'Exemplo: face-finder ~/Projetos/face-finder/fotos -o ~/face-finder-saida --abrir'"
