#!/bin/sh
# ianinja-compositor-auto — corre no início da sessão Xfce (XDG autostart).
# Em modo de recurso gráfico (entrada "modo gráfico de compatibilidade" = nomodeset, nível de
# recurso do ianinja-dm, placa sem nó de render /dev/dri/renderD*, ou OpenGL por software
# llvmpipe/softpipe) desliga o compositor do xfwm4: aí as sombras e transparências são
# desenhadas pelo CPU e tornam tudo lento. Fica uma marca em ~/.config/ianinjapelagestao; no
# arranque normal seguinte (com persistência) o compositor volta a ser ligado. Se o próprio
# utilizador o desligou (sem marca), não lhe toca. Instalado por scripts/apps/funcoes-10.sh.
marca=${XDG_CONFIG_HOME:-$HOME/.config}/ianinjapelagestao/compositor-desligado-auto
command -v xfconf-query > /dev/null || exit 0
recurso=0
grep -qw nomodeset /proc/cmdline && recurso=1
[ -e /etc/X11/xorg.conf.d/90-ianinja-recurso.conf ] && recurso=1
ls /dev/dri/renderD* > /dev/null 2>&1 || recurso=1
if [ $recurso = 0 ] && command -v glxinfo > /dev/null; then
  glxinfo -B 2> /dev/null | grep -qiE "renderer string:.*(llvmpipe|softpipe)" && recurso=1
fi
atual=$(xfconf-query -c xfwm4 -p /general/use_compositing 2> /dev/null)
if [ $recurso = 1 ]; then
  [ "$atual" = false ] && exit 0
  xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false || exit 0
  mkdir -p "${marca%/*}" && : > "$marca"
elif [ -e "$marca" ]; then
  xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s true && rm -f "$marca"
fi
exit 0
